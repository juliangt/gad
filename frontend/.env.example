# URL base del backend (sin sufijo /api). En dev el proxy Vite reescribe /api/* → BACKEND/*
# Este valor (http://localhost:8000) es para desarrollo local sin Docker (dev server de Vite).
# En el build de Docker (nginx) se deja VACÍO para que las llamadas sean URLs relativas
# y las sirva el proxy de nginx. El Dockerfile ya lo gestiona (ARG VITE_API_URL=),
# así que normalmente no hace falta setearlo a mano.
VITE_API_URL=http://localhost:8000
# URL base del WebSocket del backend.
VITE_WS_URL=ws://localhost:8000
# Client ID de Google OAuth (vacío = botón Google no se muestra).
VITE_OAUTH_GOOGLE_CLIENT_ID=
# Activa Web Push (requiere HTTPS + VAPID en backend). Fuera de alcance en F7;
# se incluye el flag para cuando se incorpore vite-plugin-pwa. Default: true.
# VITE_ENABLE_PUSH=true
