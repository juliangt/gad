# Variables de entorno de GAD. Copiar a .env y completar.
# Estas variables las leen los servicios definidos en docker-compose.yml
# (db, api y seed) a través del env_file del compose.
POSTGRES_USER=gad
POSTGRES_PASSWORD=cambiar-en-prod
POSTGRES_DB=gad
JWT_SECRET=cambiar-por-un-secreto-de-16-chars-o-mas
# Con nginx como único punto de entrada (prod-like) el CORS no es estrictamente
# necesario (mismo origen), pero se deja por robustez. En dev, el proxy de Vite
# resuelve las llamadas al backend.
CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=dev
# Rate limiting (slowapi). En dev/local conviene desactivarlo para que los tests
# E2E (que disparan muchos logins desde la misma IP) no reciban 429.
# En producción dejarlo en true (default del backend).
RATE_LIMIT_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Para el frontend, ver frontend/.env.example (VITE_API_URL vacío = URLs relativas para nginx).
